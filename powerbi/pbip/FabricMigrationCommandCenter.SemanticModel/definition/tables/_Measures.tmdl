	measure 'KPI SVG Artifacts' =
			VAR vValue = [Total Artifacts]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "#,0"))
			VAR vCaption = FORMAT([Migrated Artifacts], "#,0") & " migrated · " & FORMAT([In-Flight Artifacts], "#,0") & " in flight · " & FORMAT([Blocked Artifacts], "#,0") & " blocked"
			VAR vRailTotal = COALESCE([Migrated Artifacts], 0) + COALESCE([In-Flight Artifacts], 0) + COALESCE([Blocked Artifacts], 0) + COALESCE([Not Started Artifacts], 0)
			VAR vW0 = ROUND(264 * DIVIDE(COALESCE([Migrated Artifacts], 0), vRailTotal), 0)
			VAR vW1 = ROUND(264 * DIVIDE(COALESCE([In-Flight Artifacts], 0), vRailTotal), 0)
			VAR vW2 = ROUND(264 * DIVIDE(COALESCE([Blocked Artifacts], 0), vRailTotal), 0)
			VAR vW3 = ROUND(264 * DIVIDE(COALESCE([Not Started Artifacts], 0), vRailTotal), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<text x='16' y='26' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Artifacts in scope</text>"
			        & ""
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#FFFFFF'>" & vShown & "</text>"
			        & "<clipPath id='r'><rect x='16' y='76' width='264' height='6' rx='3'/></clipPath>" & "<rect x='16' y='76' width='264' height='6' rx='3' fill='#2C2F55'/>" & "<g clip-path='url(#r)'>" & "<rect x='" & 16 & "' y='76' width='" & vW0 & "' height='6' fill='#2DD4C4'/>" & "<rect x='" & (16 + vW0) & "' y='76' width='" & vW1 & "' height='6' fill='#8B8BFF'/>" & "<rect x='" & ((16 + vW0) + vW1) & "' y='76' width='" & vW2 & "' height='6' fill='#FF5C7A'/>" & "<rect x='" & (((16 + vW0) + vW1) + vW2) & "' y='76' width='" & vW3 & "' height='6' fill='#454A82'/>" & "</g>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 70560d21-6cee-5ccc-9fa2-4b6282920c8c
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Migrated' =
			VAR vValue = [% Migrated]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaption = FORMAT([Migrated Artifacts], "#,0") & " of " & FORMAT([Total Artifacts], "#,0") & " cut over or retired"
			VAR vRailTotal = COALESCE([Migrated Artifacts], 0) + COALESCE([Total Artifacts] - [Migrated Artifacts], 0)
			VAR vW0 = ROUND(264 * DIVIDE(COALESCE([Migrated Artifacts], 0), vRailTotal), 0)
			VAR vW1 = ROUND(264 * DIVIDE(COALESCE([Total Artifacts] - [Migrated Artifacts], 0), vRailTotal), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<text x='16' y='26' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Migrated</text>"
			        & ""
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#FFFFFF'>" & vShown & "</text>"
			        & "<clipPath id='r'><rect x='16' y='76' width='264' height='6' rx='3'/></clipPath>" & "<rect x='16' y='76' width='264' height='6' rx='3' fill='#2C2F55'/>" & "<g clip-path='url(#r)'>" & "<rect x='" & 16 & "' y='76' width='" & vW0 & "' height='6' fill='#2DD4C4'/>" & "<rect x='" & (16 + vW0) & "' y='76' width='" & vW1 & "' height='6' fill='#2C2F55'/>" & "</g>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: df90d152-3cbb-5db0-905a-a440f8431153
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG GO Rate' =
			VAR vValue = [GO Rate]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaption = FORMAT([GO Runs], "#,0") & " GO · " & FORMAT([NO-GO Runs], "#,0") & " NO-GO of " & FORMAT([Validation Runs], "#,0") & " runs"
			VAR vRailTotal = COALESCE([GO Runs], 0) + COALESCE([NO-GO Runs], 0)
			VAR vW0 = ROUND(264 * DIVIDE(COALESCE([GO Runs], 0), vRailTotal), 0)
			VAR vW1 = ROUND(264 * DIVIDE(COALESCE([NO-GO Runs], 0), vRailTotal), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<text x='16' y='26' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Parallel-run GO rate</text>"
			        & ""
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#FFFFFF'>" & vShown & "</text>"
			        & "<clipPath id='r'><rect x='16' y='76' width='264' height='6' rx='3'/></clipPath>" & "<rect x='16' y='76' width='264' height='6' rx='3' fill='#2C2F55'/>" & "<g clip-path='url(#r)'>" & "<rect x='" & 16 & "' y='76' width='" & vW0 & "' height='6' fill='#3DD68C'/>" & "<rect x='" & (16 + vW0) & "' y='76' width='" & vW1 & "' height='6' fill='#FF5C7A'/>" & "</g>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 50422758-d482-5a99-8bbe-3490ac2fb597
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Effort Variance' =
			VAR vValue = [Effort Variance %]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "+0.0%;-0.0%;0.0%"))
			VAR vCaption = FORMAT([Actual Effort Completed], "#,0") & " d actual vs " & FORMAT([Planned Effort Delivered], "#,0") & " d planned"
			VAR vRailTotal = COALESCE([Planned Effort Delivered], 0) + COALESCE(MAX([Actual Effort Completed] - [Planned Effort Delivered], 0), 0)
			VAR vW0 = ROUND(264 * DIVIDE(COALESCE([Planned Effort Delivered], 0), vRailTotal), 0)
			VAR vW1 = ROUND(264 * DIVIDE(COALESCE(MAX([Actual Effort Completed] - [Planned Effort Delivered], 0), 0), vRailTotal), 0)
			VAR vChipText = [Effort Status]
			VAR vChipColour = [Effort Colour]
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<text x='16' y='26' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Effort vs plan, completed work</text>"
			        & "<rect x='196' y='12' width='84' height='20' rx='10' fill='" & vChipColour & "' fill-opacity='0.18'/>" & "<text x='238' y='26' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & vChipColour & "'>" & vChipText & "</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#FFFFFF'>" & vShown & "</text>"
