table _Measures
	lineageTag: 477ab2dd-d300-4e93-b4e5-25ae122bac3b

	measure 'Total Artifacts' = COUNTROWS(migration_artifacts)
		formatString: #,0
		lineageTag: f32f1b3f-43b5-4f04-92ae-a99f9f650837

	measure 'Migrated Artifacts' = CALCULATE(COUNTROWS(migration_artifacts), migration_artifacts[status] IN {"Cutover", "Retired"})
		formatString: #,0
		lineageTag: 8cb4fa23-8b65-4134-aa9c-ba8b43d3806b

	measure '% Migrated' = DIVIDE([Migrated Artifacts], [Total Artifacts])
		formatString: 0.0%
		lineageTag: 9dbdd5f5-f0c9-4d60-93b4-6cbbda63204d

	measure 'Blocked Artifacts' = CALCULATE(COUNTROWS(migration_artifacts), migration_artifacts[status] = "Blocked")
		formatString: #,0
		lineageTag: ce4ab325-ebf3-4f1a-a7e4-6c098aebe778

	measure 'In-Flight Artifacts' = CALCULATE(COUNTROWS(migration_artifacts), migration_artifacts[status] IN {"In Progress", "Parallel Run"})
		formatString: #,0
		lineageTag: f2f6d40f-adc6-4516-8f5b-cced77c51560

	measure 'Planned Effort (days)' = SUM(migration_artifacts[effort_planned_days])
		formatString: #,0.0
		lineageTag: 0499d6fe-41af-40ad-9ba6-188573c513c7

	measure 'Actual Effort (days)' = SUM(migration_artifacts[effort_actual_days])
		formatString: #,0.0
		lineageTag: cb3823bc-72d1-4cc9-a404-dd923969b909

	measure 'Effort Variance %' =
			VAR vDone =
			    FILTER(migration_artifacts, migration_artifacts[status] IN {"Cutover", "Retired"})
			RETURN
			    DIVIDE(
			        SUMX(vDone, migration_artifacts[effort_actual_days] - migration_artifacts[effort_planned_days]),
			        SUMX(vDone, migration_artifacts[effort_planned_days])
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 67e05131-73ea-433c-983c-44fc73caa461

	measure 'Validation Runs' = COUNTROWS(validation_runs)
		formatString: #,0
		lineageTag: a52b87ee-715b-4c33-9e10-07f0b4981637

	measure 'GO Runs' = CALCULATE(COUNTROWS(validation_runs), validation_runs[verdict] = "GO")
		formatString: #,0
		lineageTag: 3e8454b0-c94e-4ae1-bf59-c65599f4abc9

	measure 'NO-GO Runs' = CALCULATE(COUNTROWS(validation_runs), validation_runs[verdict] = "NO-GO")
		formatString: #,0
		lineageTag: 29b8af88-cf2f-477f-97d5-688a9ce99626

	measure 'GO Rate' = DIVIDE([GO Runs], [Validation Runs])
		formatString: 0.0%
		lineageTag: 4a3e196d-22d6-42ad-962e-fc24e354bf69

	/// Running total of artifacts cut over on or before the month on the axis.
	/// ALL(migration_artifacts) used to sit where REMOVEFILTERS(dim_month) sits
	/// now. It cleared the date the running total re-establishes, but it also
	/// cleared the Domain and Source Type slicers standing beside this chart:
	/// filtering to Finance moved every other visual on the page and left this
	/// line at the whole-estate total. Only the date and the cutover column are
	/// released here, so the slicers still reach the running total.
	measure 'Cumulative Cutovers' =
			VAR vMonthEnd = EOMONTH(MAX(dim_month[month_start]), 0)
			RETURN
			    CALCULATE(
			        COUNTROWS(migration_artifacts),
			        REMOVEFILTERS(dim_month),
			        FILTER(
			            ALL(migration_artifacts[actual_cutover]),
			            NOT ISBLANK(migration_artifacts[actual_cutover])
			                && migration_artifacts[actual_cutover] <= vMonthEnd
			        )
			    )
		formatString: #,0
		lineageTag: 6c4847a4-5f83-4349-bc95-d9389c1ed82c

	/// The plan line, released the same way as the actual line so the two stay
	/// comparable under a slicer: filter to one domain and both curves are that
	/// domain's, not one domain against the whole programme's plan.
	measure 'Planned Cumulative Cutovers' =
			VAR vMonthEnd = EOMONTH(MAX(dim_month[month_start]), 0)
			RETURN
			    CALCULATE(
			        COUNTROWS(migration_artifacts),
			        REMOVEFILTERS(dim_month),
			        FILTER(
			            ALL(migration_artifacts[planned_cutover]),
			            migration_artifacts[planned_cutover] <= vMonthEnd
			        )
			    )
		formatString: #,0
		lineageTag: e559d2cb-d5aa-4fc9-b38d-6b88852b40e3

	measure 'Effort Status' =
			VAR vGap = [Effort Variance %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vGap), "No data",
			        vGap <= 0, "Under plan",
			        vGap <= 0.1, "Watch",
			        "Over plan"
			    )
		lineageTag: d3b621f5-3851-517d-a1f9-3a8995532051
		displayFolder: Verdict

	measure 'Effort Colour' =
			SWITCH(
			    [Effort Status],
			    "Under plan", "#3DD68C",
			    "Watch", "#F5A524",
			    "No data", "#454A82",
			    "#FF5C7A"
			)
		lineageTag: 33e605c2-91c0-5fcf-abee-94cc566cc27f
		displayFolder: Verdict

	measure 'Migration Reference' = "of " & FORMAT([Total Artifacts], "#,0") & " artifacts   " & FORMAT([In-Flight Artifacts], "#,0") & " in flight, " & FORMAT([Blocked Artifacts], "#,0") & " blocked"
		lineageTag: 028f0a0a-7512-564e-bf5a-d65a639c8074
		displayFolder: Verdict

	measure 'Effort Reference' = "Planned " & FORMAT([Planned Effort (days)], "#,0") & " d   actual " & FORMAT([Actual Effort (days)], "#,0") & " d"
		lineageTag: 9eb760bf-eb4a-539b-b028-c69ef26405af
		displayFolder: Verdict

	measure 'GO Rate Reference' = "of " & FORMAT([Validation Runs], "#,0") & " runs   " & FORMAT([NO-GO Runs], "#,0") & " NO-GO"
		lineageTag: 05b7df2a-235e-5341-a18d-1cace9e819db
		displayFolder: Verdict

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'NO-GO Reason Colour' =
			VAR vHere = [NO-GO Runs]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(validation_runs[mismatch_reason]), [NO-GO Runs]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		lineageTag: 1cce3568-c04d-5710-a79e-811410f1e4b9
		displayFolder: Verdict

	/// Programme status in one sentence for the command centre.
	measure 'Migration Insight' =
			VAR vPct = [% Migrated]
			VAR vWorstReason =
			    MAXX(TOPN(1, VALUES(validation_runs[mismatch_reason]), [NO-GO Runs], DESC), validation_runs[mismatch_reason])
			VAR vWorstRuns = CALCULATE([NO-GO Runs], validation_runs[mismatch_reason] = vWorstReason)
			RETURN
			    FORMAT(vPct, "0.0%") & " of " & FORMAT([Total Artifacts], "#,0")
			        & " artifacts migrated, " & FORMAT([Blocked Artifacts], "#,0") & " blocked. Effort is "
			        & FORMAT(ABS([Effort Variance %]), "0.0%") & IF([Effort Variance %] > 0, " over", " under")
			        & " plan. GO rate " & FORMAT([GO Rate], "0.0%") & ", and "
			        & vWorstReason & " accounts for the most NO-GO verdicts at "
			        & FORMAT(vWorstRuns, "#,0") & " runs."
		lineageTag: 2d7d4582-253c-58b6-a3f0-17fea1881141
		displayFolder: Verdict

	measure 'Selected Metric Label' = SELECTEDVALUE('Chart Metric'[Metric], "Artifacts")
		lineageTag: 28fad75e-5845-5bc6-8a22-4334992dd7e4
		displayFolder: Report UI

	measure 'Selected Metric' =
			SWITCH(
			    [Selected Metric Label],
			    "Planned days", [Planned Effort (days)],
