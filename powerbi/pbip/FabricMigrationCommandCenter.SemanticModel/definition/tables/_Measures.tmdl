	measure 'Wave Progress SVG' =
			VAR vPct = COALESCE([% Migrated], 0)
			VAR vW = ROUND(96 * vPct, 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='140' height='16' viewBox='0 0 140 16'>"
			        & "<rect x='0' y='5' width='96' height='6' rx='3' fill='#2C2F55'/>"
			        & "<rect x='0' y='5' width='" & vW & "' height='6' rx='3' fill='#2DD4C4'/>"
			        & "<text x='104' y='13' font-family='Segoe UI' font-size='10' fill='#EDEFFA'>" & FORMAT(vPct, "0%") & "</text>"
			        & "</svg>"
			RETURN
			    IF(ISBLANK([Total Artifacts]), BLANK(), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23"))
