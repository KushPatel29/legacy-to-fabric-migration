	measure 'KPI SVG Planned Effort' =
			VAR vValue = [Planned Effort (days)]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "#,0"))
			VAR vCaption = FORMAT([Planned Effort Delivered], "#,0") & " d delivered · " & FORMAT([Planned Effort Remaining], "#,0") & " d to go"
			VAR vRailTotal = COALESCE([Planned Effort Delivered], 0) + COALESCE([Planned Effort Remaining], 0)
			VAR vW0 = ROUND(264 * DIVIDE(COALESCE([Planned Effort Delivered], 0), vRailTotal), 0)
			VAR vW1 = ROUND(264 * DIVIDE(COALESCE([Planned Effort Remaining], 0), vRailTotal), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<text x='16' y='26' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Planned effort (days)</text>"
			        & ""
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#FFFFFF'>" & vShown & "</text>"
			        & "<clipPath id='r'><rect x='16' y='76' width='264' height='6' rx='3'/></clipPath>" & "<rect x='16' y='76' width='264' height='6' rx='3' fill='#2C2F55'/>" & "<g clip-path='url(#r)'>" & "<rect x='" & 16 & "' y='76' width='" & vW0 & "' height='6' fill='#2DD4C4'/>" & "<rect x='" & (16 + vW0) & "' y='76' width='" & vW1 & "' height='6' fill='#2C2F55'/>" & "</g>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
