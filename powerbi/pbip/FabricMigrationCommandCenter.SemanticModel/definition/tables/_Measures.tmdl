		displayFolder: Report UI

	measure 'Effort Variance SVG' =
			VAR vGap = [Effort Variance %]
			VAR vColour = [Effort Colour]
			VAR vText = IF(ISBLANK(vGap), "no completed work", FORMAT(vGap, "+0%;-0%;0%") & "  " & [Effort Status])
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='150' height='18' viewBox='0 0 150 18'>"
			        & "<rect x='0' y='1' width='148' height='16' rx='8' fill='" & vColour & "' fill-opacity='0.18'/>"
			        & "<text x='74' y='13' text-anchor='middle' font-family='Segoe UI Semibold' font-size='10' fill='" & IF(ISBLANK(vGap), "#8B90B8", vColour) & "'>" & vText & "</text>"
			        & "</svg>"
			RETURN
			    IF(ISBLANK([Total Artifacts]), BLANK(), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23"))
