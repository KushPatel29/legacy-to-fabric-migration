	measure 'Planned Effort Delivered' = CALCULATE([Planned Effort (days)], migration_artifacts[status] IN {"Cutover", "Retired"})
		formatString: #,0.0
		lineageTag: 082f70fe-1d96-5aac-b896-6a2122dc8e5e
		displayFolder: Report UI

	measure 'Planned Effort Remaining' = [Planned Effort (days)] - [Planned Effort Delivered]
		formatString: #,0.0
		lineageTag: 4f3cbb8d-a9f5-53db-8d2d-78043e5b71bf
		displayFolder: Report UI

	measure 'Actual Effort Completed' = CALCULATE([Actual Effort (days)], migration_artifacts[status] IN {"Cutover", "Retired"})
		formatString: #,0.0
		lineageTag: 7d4adb17-7dba-50ed-9e60-2afac3a6bca5
		displayFolder: Report UI

	measure 'Validated Artifacts' = DISTINCTCOUNT(validation_runs[artifact_id])
		formatString: #,0
		lineageTag: 8cafcb43-b64b-571f-b059-6fa0a01c7443
		displayFolder: Report UI

	measure 'First-Attempt GO Rate' = CALCULATE([GO Rate], validation_runs[attempt] = 1)
		formatString: 0.0%
		lineageTag: ad3352bb-fcb8-5859-8713-cd1fff6381e4
		displayFolder: Report UI

	measure 'Top NO-GO Reason' =
			VAR vTop = TOPN(1, FILTER(VALUES(validation_runs[mismatch_reason]), NOT ISBLANK(validation_runs[mismatch_reason])), [NO-GO Runs], DESC)
			RETURN MAXX(vTop, validation_runs[mismatch_reason])
		lineageTag: 238d0eaf-ab05-5190-afaa-940a41141bd1
		displayFolder: Report UI

	measure 'Filter Context' =
			VAR vDomain = IF(ISFILTERED(migration_artifacts[domain]), CONCATENATEX(VALUES(migration_artifacts[domain]), migration_artifacts[domain], ", "), "All domains")
			VAR vSource = IF(ISFILTERED(migration_artifacts[source_type]), CONCATENATEX(VALUES(migration_artifacts[source_type]), migration_artifacts[source_type], ", "), "all source types")
			VAR vTier = IF(ISFILTERED(migration_artifacts[criticality]), CONCATENATEX(VALUES(migration_artifacts[criticality]), migration_artifacts[criticality], ", "), "all tiers")
			VAR vVerdict = IF(ISFILTERED(validation_runs[verdict]), " · " & CONCATENATEX(VALUES(validation_runs[verdict]), validation_runs[verdict], ", ") & " runs", "")
			VAR vText = vDomain & " · " & vSource & " · " & vTier & vVerdict
			RETURN IF(LEN(vText) > 54, LEFT(vText, 52) & "…", vText)
		lineageTag: 333f65df-335d-5a01-8efc-96e0ec038b9a
		displayFolder: Report UI

	measure 'Filter Button Label' =
			VAR vOn = INT(ISFILTERED(migration_artifacts[domain])) + INT(ISFILTERED(migration_artifacts[source_type])) + INT(ISFILTERED(migration_artifacts[criticality]))
			RETURN IF(vOn = 0, "Filters", "Filters · " & vOn)
		lineageTag: 3dbb9bbd-ca68-5377-b2bf-cff1cfe11a30
		displayFolder: Report UI

	measure 'Header SVG Migration Command Center' =
			VAR vContext = [Filter Context]
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='56' viewBox='0 0 336 56'>"
			        & "<text x='0' y='24' font-family='Segoe UI Semibold' font-size='18' fill='#EDEFFA'>Migration Command Center</text>"
			        & "<text x='0' y='46' font-family='Segoe UI' font-size='11' fill='#8B90B8'>" & vContext & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 4b576bdf-c568-5406-8683-ef6a1abccd1a
		dataCategory: ImageUrl
		displayFolder: Report UI

